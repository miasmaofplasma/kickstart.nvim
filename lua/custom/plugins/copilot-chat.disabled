local set_keybinds = function()
  local map = function(mode, lhs, rhs, desc)
    vim.keymap.set(mode, lhs, rhs, { noremap = true, silent = true, desc = desc })
  end
  local cpc = require 'CopilotChat'

  -- UI
  map('n', '<leader>cc', function()
    return (type(cpc.toggle) == 'function' and cpc.toggle or cpc.open)()
  end, 'CopilotChat: Toggle')
  map('n', '<leader>cR', function()
    return (type(cpc.reset) == 'function' and cpc.reset or vim.cmd.CopilotChatReset)()
  end, 'CopilotChat: Reset')

  -- Actions (work in normal/visual)
  map({ 'n', 'v' }, '<leader>ce', '<cmd>CopilotChatExplain<cr>', 'CopilotChat: Explain')
  map({ 'n', 'v' }, '<leader>cr', '<cmd>CopilotChatReview<cr>', 'CopilotChat: Review')
  map({ 'n', 'v' }, '<leader>cf', '<cmd>CopilotChatFix<cr>', 'CopilotChat: Fix')
  map({ 'n', 'v' }, '<leader>co', '<cmd>CopilotChatOptimize<cr>', 'CopilotChat: Optimize')
  map({ 'n', 'v' }, '<leader>cd', '<cmd>CopilotChatDocs<cr>', 'CopilotChat: Docs')
  map({ 'n', 'v' }, '<leader>ct', '<cmd>CopilotChatTests<cr>', 'CopilotChat: Tests')

  -- Git commit helpers
  map('n', '<leader>cC', '<cmd>CopilotChatCommit<cr>', 'CopilotChat: Commit message (diff)')
  map('n', '<leader>cS', '<cmd>CopilotChatCommitStaged<cr>', 'CopilotChat: Commit message (staged)')

  -- Prompt actions (Telescope)
  map('n', '<leader>cp', '<cmd>CopilotChatPrompts<cr>', 'CopilotChat: Prompt actions')

  -- Quick ask: buffer (n) or visual (v)
  map('n', '<leader>cq', function()
    local input = vim.fn.input 'CopilotChat: '
    if input ~= '' then
      cpc.ask(input, { selection = require('CopilotChat.select').buffer })
    end
  end, 'CopilotChat: Ask about buffer')
  map('v', '<leader>cq', function()
    local input = vim.fn.input 'CopilotChat: '
    if input ~= '' then
      cpc.ask(input, { selection = require('CopilotChat.select').visual })
    end
  end, 'CopilotChat: Ask about selection')
end

return {
  'CopilotC-Nvim/CopilotChat.nvim',
  event = 'VeryLazy',
  dependencies = {
    'nvim-lua/plenary.nvim',
    'nvim-telescope/telescope.nvim',
    {
      'nvim-lua/plenary.nvim',
      branch = 'master',
    },
  },
  config = function()
    local cpc = require 'CopilotChat'
    cpc.setup {
      model = 'gpt-5',
      temperature = 0.2,
      window = {
        layout = 'vertical',
        width = 0.5,
      },
      auto_insert_mode = true,
      selection = function(source)
        return require('CopilotChat.select').visual(source) or require('CopilotChat.select').line(source)
      end,
    }
    set_keybinds()
  end,
}
