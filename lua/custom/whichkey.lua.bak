local wk_ok, which_key = pcall(require, 'which-key')
if not wk_ok then
  return
end

-- Configure which-key (moved from init.lua plugin opts)
which_key.setup {
  -- delay between pressing a key and opening which-key (milliseconds)
  -- this setting is independent of vim.o.timeoutlen
  delay = 0,
  icons = {
    -- set icon mappings to true if you have a Nerd Font
    mappings = vim.g.have_nerd_font,
    -- If you are using a Nerd Font: set icons.keys to an empty table which will use the
    -- default which-key.nvim defined Nerd Font icons, otherwise define a string table
    keys = vim.g.have_nerd_font and {} or {
      Up = '<Up> ',
      Down = '<Down> ',
      Left = '<Left> ',
      Right = '<Right> ',
      C = '<C-…> ',
      M = '<M-…> ',
      D = '<D-…> ',
      S = '<S-…> ',
      CR = '<CR> ',
      Esc = '<Esc> ',
      ScrollWheelDown = '<ScrollWheelDown> ',
      ScrollWheelUp = '<ScrollWheelUp> ',
      NL = '<NL> ',
      BS = '<BS> ',
      Space = '<Space> ',
      Tab = '<Tab> ',
      F1 = '<F1>',
      F2 = '<F2>',
      F3 = '<F3>',
      F4 = '<F4>',
      F5 = '<F5>',
      F6 = '<F6>',
      F7 = '<F7>',
      F8 = '<F8>',
      F9 = '<F9>',
      F10 = '<F10>',
      F11 = '<F11>',
      F12 = '<F12>',
    },
  },
}

-- Centralized which-key registrations for discoverability
which_key.register({
  s = {
    name = 'Search',
    h = 'Help Tags',
    k = 'Keymaps',
    f = 'Find Files',
    s = 'Telescope Pickers',
    ['*'] = 'Search Current Word',
    g = 'Live Grep',
    d = 'Diagnostics',
    r = 'Resume',
    ['.'] = 'Recent Files',
    t = 'Treesitter',
    ['<leader>'] = 'Buffers',
    w = 'Workspaces',
    o = 'Notes',
  },

  t = {
    name = 'Test',
    a = 'Run All Tests',
    r = 'Run Test',
    d = 'Debug Test',
    s = 'Test Summary',
    o = 'Test Output',
  },

  o = {
    name = 'Opencode',
    ['?'] = 'Ask opencode…',
    a = 'Execute opencode action…',
    o = 'Toggle opencode',
  },

  c = {
    name = 'Wtf',
    d = 'Debug diagnostic with AI',
    f = 'Fix diagnostic with AI',
    s = 'Search diagnostic with Google',
    p = 'Pick provider',
    h = 'Populate quickfix with previous chat history',
    g = 'Grep previous chat history with Telescope',
  },

  h = {
    name = 'Git Hunk',
    s = 'Stage Hunk',
    r = 'Reset Hunk',
    S = 'Stage Buffer',
    u = 'Undo Stage Hunk',
    R = 'Reset Buffer',
    p = 'Preview Hunk',
    b = 'Blame Line',
    d = 'Diff Against Index',
    D = 'Diff Against Last Commit',
  },

  w = {
    name = 'Window',
    m = 'Maximize',
    e = 'Equalize',
    t = 'New Tab',
    c = 'Close Tab',
    o = 'Only',
  },

  n = {
    name = 'Notes',
    n = 'New Note',
    d = 'Daily Note',
    w = 'Weekly Note',
    ['/'] = 'Search Notes',
  },

  x = {
    name = 'Trouble',
    x = 'Toggle Diagnostics',
    X = 'Buffer Diagnostics',
    s = 'Symbols',
    l = 'LSP Listings',
    L = 'Location List',
    Q = 'Quickfix List',
  },

  d = {
    name = 'Debug',
    l = 'Step Into',
    j = 'Step Over',
    k = 'Step Out',
    c = 'Continue',
    b = 'Toggle Breakpoint',
    dd = 'Set conditional breakpoint',
    e = 'Terminate/Reset',
    r = 'Run Last',
  },

  ['<leader>'] = {
    q = 'Open diagnostic Quickfix',
    f = 'Format buffer',
    e = 'Open diagnostic float',
    ['xh'] = 'Toggle inlay hints',
  },
}, { prefix = '<leader>' })

-- Register a few non-leader mappings for discoverability
which_key.register({
  go = 'Add range to opencode',
  goo = 'Add line to opencode',
  ['<C-k>'] = 'Scroll opencode up',
  ['<C-j>'] = 'Scroll opencode down',
}, { mode = 'n' })

return which_key
